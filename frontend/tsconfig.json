{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "paths": {
      "@wailsio/runtime": ["../../wails/v3/internal/runtime/desktop/@wailsio/runtime/src/index.ts"],
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    },
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "bindings/**/*.ts",
    "../../wails/v3/internal/runtime/desktop/@wailsio/runtime/src/global.d.ts"
  ]
}
