<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="telesma.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Savely Krasovsky\Telesma">
    </Installer>
    <PackageInformation
        PackageName="Telesma"
        PackageDisplayName="Telesma"
        PublisherName="CN=Savely Krasovsky"
        PublisherDisplayName="Savely Krasovsky"
        Version="0.1.0.0"
        PackageDescription="Desktop workbench for local FIDO2/CTAP authenticators">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.telesma.Telesma"
                Description="Desktop workbench for local FIDO2/CTAP authenticators"
                DisplayName="Telesma"
                ExecutableName="telesma.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Telesma</DisplayName>
            <PublisherDisplayName>Savely Krasovsky</PublisherDisplayName>
            <Description>Desktop workbench for local FIDO2/CTAP authenticators</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="telesma.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
